{
  "mappings": [
    {
      "name": "work by id",
      "request": { "method": "GET", "urlPathPattern": "/internal/works/[^/]+" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "id": "11111111-1111-4111-8111-000000000001",
          "name": "Troca de óleo",
          "description": "Troca de óleo do motor com filtro incluído",
          "unit_price": "150.00",
          "active": true
        }
      }
    },
    {
      "name": "reserve supply",
      "request": { "method": "POST", "urlPath": "/internal/reservations" },
      "response": {
        "status": 201,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": {
          "reservation_id": "{{randomValue type='UUID'}}",
          "supply_id": "{{jsonPath request.body '$.supply_id'}}",
          "name": "Filtro",
          "description": "Filtro de óleo",
          "unit_price": "35.50",
          "version": 3
        },
        "transformers": ["response-template"]
      }
    },
    {
      "name": "release reservation",
      "request": { "method": "DELETE", "urlPathPattern": "/internal/reservations/[^/]+" },
      "response": { "status": 204 }
    }
  ]
}
